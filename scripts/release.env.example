# Modèle de configuration pour scripts/release.sh.
#
#   cp scripts/release.env.example scripts/release.env
#
# release.env contient des identifiants : il est gitignoré, ne le versionne pas.
# Où trouver chaque valeur : docs/appstore/publication.md, étapes 1 et 4.

# Team ID du compte Apple Developer payant, 10 caractères.
# developer.apple.com → Account → Membership details → Team ID.
# À reporter aussi dans DEVELOPMENT_TEAM de project.yml (le script le vérifie).
LUMA_TEAM_ID=XXXXXXXXXX

# Clé d'API App Store Connect, créée dans
# App Store Connect → Utilisateurs et accès → Intégrations → App Store Connect API.
# Rôle « App Manager » suffisant.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Chemin du fichier .p8 téléchargé à la création de la clé.
# Apple ne le propose qu'UNE seule fois : garde-le en sécurité, hors du dépôt.
# Le dossier est libre (release.sh le communique à altool), mais le nom du
# fichier doit rester AuthKey_<ASC_KEY_ID>.p8 : altool le reconstruit ainsi.
ASC_KEY_PATH=~/Documents/AppleDev/AuthKey_XXXXXXXXXX.p8
