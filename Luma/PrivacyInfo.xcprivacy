<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Aucun suivi publicitaire, aucun domaine contacté. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Aucune donnée collectée : rien ne quitte l'appareil. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- API à « raison d'usage requise » utilisées par l'app. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- @AppStorage("filmStock") dans MeterView : mémorise la pellicule chargée. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1 : accès aux informations de cette app uniquement. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
